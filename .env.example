# ---- control plane ----
DATABASE_URL=postgresql+asyncpg://gtmos:gtmos@localhost:5432/gtmos
GTMOS_PUBLIC_URL=http://localhost:8000

# ---- auth (Cognito behind FastMCP OAuthProxy) ----
COGNITO_DOMAIN=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_REGION=us-east-1

# ---- queue ----
SQS_RUN_QUEUE_URL=
AWS_REGION=us-east-1

# ---- secrets (tenant BYOK) ----
SECRETS_PREFIX=gtmos/tenants

# ---- models ----
ANTHROPIC_API_KEY=
GTMOS_STRUCTURING_MODEL=claude-haiku-4-5-20251001
GTMOS_REASONING_MODEL=claude-sonnet-5

# ---- bridge (local machine only) ----
GTMOS_BRIDGE_URL=ws://localhost:8000/bridge/ws
GTMOS_BRIDGE_TOKEN=
